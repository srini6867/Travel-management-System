generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("STAFF")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  trips        Trip[]
}

model Route {
  id     Int    @id @default(autoincrement())
  name   String @unique
  code   String?
  status String @default("ACTIVE")
  trips  Trip[]
}

model Vehicle {
  id       Int         @id @default(autoincrement())
  regNo    String      @unique
  label    String?
  status   String      @default("ACTIVE")
  trips    Trip[]
  diesels  DieselLog[]
  expenses Expense[]
}

model Client {
  id     Int    @id @default(autoincrement())
  name   String @unique
  phone  String?
  status String @default("ACTIVE")
  trips  Trip[]
}

model Driver {
  id     Int    @id @default(autoincrement())
  name   String @unique
  phone  String?
  status String @default("ACTIVE")
  trips  Trip[]
}

model Cleaner {
  id     Int    @id @default(autoincrement())
  name   String @unique
  phone  String?
  status String @default("ACTIVE")
  trips  Trip[]
}

model ExpenseType {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  status   String    @default("ACTIVE")
  expenses Expense[]
}

model Trip {
  id            Int      @id @default(autoincrement())
  tripDate      DateTime
  routeId       Int
  vehicleId     Int
  clientId      Int
  driverId      Int?
  cleanerId     Int?
  distanceKm    Float    @default(0)
  ratePerKm     Float    @default(0)
  amount        Float    @default(0)
  diesel        Float    @default(0)
  driverSalary  Float    @default(0)
  cleanerSalary Float    @default(0)
  toll          Float    @default(0)
  waterBottle   Float    @default(0)
  parking       Float    @default(0)
  adBlue        Float    @default(0)
  other         Float    @default(0)
  otherNote     String?
  halt          Boolean  @default(false)
  createdById   Int
  createdAt     DateTime @default(now())

  route     Route    @relation(fields: [routeId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  client    Client   @relation(fields: [clientId], references: [id])
  driver    Driver?  @relation(fields: [driverId], references: [id])
  cleaner   Cleaner? @relation(fields: [cleanerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([tripDate])
}

model Expense {
  id            Int         @id @default(autoincrement())
  expenseTypeId Int
  vehicleId     Int?
  month         DateTime
  amount        Float
  note          String?
  createdAt     DateTime    @default(now())

  expenseType ExpenseType @relation(fields: [expenseTypeId], references: [id])
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id])
}

model DieselLog {
  id            Int      @id @default(autoincrement())
  vehicleId     Int
  fillDate      DateTime
  amount        Float
  paymentMethod String   @default("CASH")
  note          String?
  createdAt     DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([fillDate])
}
